{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_REPLACE_WITH_REVENUECAT_PUBLIC_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_REPLACE_WITH_REVENUECAT_PUBLIC_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_REVENUECAT_IOS_KEY": "appl_REPLACE_WITH_REVENUECAT_PUBLIC_KEY"
      }
    }
  }
}
