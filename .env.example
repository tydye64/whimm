# Copy to .env.local for local `expo start` / `expo run:ios` builds.
# EAS builds instead read the same var from eas.json's per-profile env block.

# RevenueCat public API key for iOS ("appl_..."). Public by design — it ships
# inside the binary — but must still come from the RevenueCat dashboard, not
# be invented. Leave unset to run unconfigured: `pro` then stays whatever was
# last persisted, which is what web and the simulator fall back to anyway,
# since neither can reach the App Store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
